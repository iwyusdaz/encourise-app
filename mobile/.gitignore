#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Native build cache (CMake/ninja)
build/.cxx/

# Gradle project cache
/android/.gradle/
/android/.kotlin/
/android/build/

# llama.cpp git history (not needed, we vendor the source)
/android/app/src/main/cpp/llama.cpp/.git/

# Large model assets (download separately)
assets/models/*.gguf
*.litertlm
